# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.env

# Data (never commit raw/processed data or model weights)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Experiment outputs (pack them with `make pack` to download). Only the full run's tables,
# figures and records are kept in the repo; weights are on Hugging Face (RamadhanZome/grama).
results/*
!results/full/
results/full/models/
results/full/config/
results/full/README.md
results_*.zip
results_*.tar.gz

# Model artifacts & logs
checkpoints/
runs/
*.pt
*.pth
*.ckpt
wandb/
mlruns/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
