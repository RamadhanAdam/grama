# Copy to .env and fill in as needed.

# Set to 1 on machines with a CUDA GPU + mamba-ssm installed (e.g. Kinesis Network A100 node).
# Set to 0 to force the pure-PyTorch selective-scan fallback (e.g. local CPU dev).
GRAMA_USE_CUDA_MAMBA=0

# Root of the CIC-IoV2024 dataset once manually downloaded and placed.
GRAMA_DATA_ROOT=./data/raw

# Random seed for reproducibility across data split / model init / client sampling.
GRAMA_SEED=42
